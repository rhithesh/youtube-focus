{
  "manifest_version": 3,
  "name": "Feed Filter — goal-aligned feeds",
  "version": "1.0.0",
  "description": "Blurs clickbait, spam and off-goal posts on YouTube, X and LinkedIn, judged against goals you write, using TypeSafe's Jev.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*",
    "https://feed-filter-two.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://www.linkedin.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Feed Filter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
